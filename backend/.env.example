# Leave MONGO_URI empty to use an in-memory MongoDB (mongomock) for quick local runs.
# For real persistence use a local mongod or MongoDB Atlas (free M0):
#   MONGO_URI=mongodb://localhost:27017
#   MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=climate_hazards

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits (requests per minute per client IP)
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=20
RATE_LIMIT_GEOCODE_PER_MIN=30

# Set to 1 only when running behind a trusted reverse proxy (Render, Cloud Run, nginx)
TRUST_PROXY=0

WEATHER_CACHE_DAYS=30
ANALYSIS_CACHE_DAYS=30
